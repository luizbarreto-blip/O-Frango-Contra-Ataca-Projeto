package mercado.personagens;

public abstract class Personagem {

    private final String nome;
    private int vida;
    private final int vidaMaxima;

    public Personagem(String nome, int vidaMaxima) {

        if (nome == null || nome.isBlank()) {
            throw new IllegalArgumentException(
                "O nome não pode ser vazio."
            );
        }

        if (vidaMaxima <= 0) {
            throw new IllegalArgumentException(
                "A vida máxima deve ser positiva."
            );
        }

        this.nome = nome;
        this.vidaMaxima = vidaMaxima;
        this.vida = vidaMaxima;
    }

    public String getNome() {
        return nome;
    }

    public int getVida() {
        return vida;
    }

    public int getVidaMaxima() {
        return vidaMaxima;
    }

    public boolean estaVivo() {
        return vida > 0;
    }

    public void receberDano(int dano) {

        if (dano < 0) {
            throw new IllegalArgumentException(
                "O dano não pode ser negativo."
            );
        }

        vida = Math.max(0, vida - dano);

        System.out.println(
            nome + " recebeu " + dano + " de dano."
        );

        System.out.println(
            "Vida: " + vida + "/" + vidaMaxima
        );
    }

    public void curar(int quantidade) {

        if (quantidade < 0) {
            throw new IllegalArgumentException(
                "A cura não pode ser negativa."
            );
        }

        vida = Math.min(
            vidaMaxima,
            vida + quantidade
        );
    }

    public abstract void atacar(Personagem alvo);
}





package mercado.personagens;

public class Frango extends Personagem {

    private static final int DANO_NORMAL = 15;
    private static final int DANO_ESPECIAL = 30;

    private static final int ENERGIA_NECESSARIA = 30;

    private int energia;

    public Frango() {
        this("Frango Congelado");
    }

    public Frango(String nome) {
        super(nome, 100);

        this.energia = 0;
    }

    public int getEnergia() {
        return energia;
    }

    @Override
    public void atacar(Personagem alvo) {

        System.out.println(
            "O frango dá uma bicada!"
        );

        alvo.receberDano(DANO_NORMAL);
    }

    public boolean usarTemperoEspecial(Personagem alvo) {

        if (energia < ENERGIA_NECESSARIA) {

            System.out.println(
                "Energia insuficiente!"
            );

            return false;
        }

        energia -= ENERGIA_NECESSARIA;

        System.out.println(
            "TEMPEROOOO ESPECIAL!"
        );

        alvo.receberDano(DANO_ESPECIAL);

        return true;
    }

    public void ganharEnergia(int quantidade) {

        if (quantidade < 0) {
            throw new IllegalArgumentException(
                "A energia não pode ser negativa."
            );
        }

        energia += quantidade;

        System.out.println(
            "Energia atual: " + energia
        );
    }
}






package mercado.inimigos;

