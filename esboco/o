package mercado.combate;

import java.util.Scanner;

import mercado.inimigos.Inimigo;
import mercado.personagens.Frango;

public class Combate {

    private final Scanner scanner;

    public Combate(Scanner scanner) {
        this.scanner = scanner;
    }

    public boolean iniciarCombate(
        Frango frango,
        Inimigo inimigo
    ) {

        System.out.println("\n========================");
        System.out.println("COMBATE: " + inimigo.getNome());
        System.out.println("========================");

        while (
            frango.estaVivo() &&
            inimigo.estaVivo()
        ) {

            System.out.println("\n" + frango.getNome());
            System.out.println("Vida: " + frango.getVida());
            System.out.println("Energia: " + frango.getEnergia());

            System.out.println("\n" + inimigo.getNome());
            System.out.println("Vida: " + inimigo.getVida());

            System.out.println("\n1 - Ataque normal");
            System.out.println("2 - Tempero Especial");

            System.out.print("Escolha sua ação: ");

            int escolha = lerEscolha();

            if (escolha == 1) {

                frango.atacar(inimigo);

            } else if (escolha == 2) {

                frango.usarTemperoEspecial(inimigo);

            } else {

                System.out.println(
                    "Opção inválida. Você perdeu o turno!"
                );
            }

            if (inimigo.estaVivo()) {
                inimigo.atacar(frango);
            }
        }

        if (frango.estaVivo()) {

            System.out.println(
                "\nVocê derrotou " + inimigo.getNome() + "!"
            );

            frango.ganharEnergia(10);

            return true;
        }

        System.out.println("\nO frango foi derrotado!");

        return false;
    }

    private int lerEscolha() {

        while (!scanner.hasNextInt()) {

            System.out.print(
                "Digite uma opção numérica: "
            );

            scanner.next();
        }

        return scanner.nextInt();
    }
}













package mercado.jogo;

import java.util.ArrayList;
import java.util.List;
import java.util.Scanner;

import mercado.combate.Combate;

import mercado.inimigos.CarrinhoMaluco;
import mercado.inimigos.CenouraMutante;
import mercado.inimigos.Gerente;
import mercado.inimigos.Inimigo;

import mercado.personagens.Frango;

public class Jogo {

    private final Scanner scanner;

    public Jogo() {
        scanner = new Scanner(System.in);
    }

    public void iniciar() {

        System.out.println("==============================");
        System.out.println("      O FRANGO CONTRA-ATACA");
        System.out.println("==============================");

        System.out.println(
            "Um frango congelado decidiu escapar!"
        );

        System.out.print(
            "\nDigite o nome do seu frango: "
        );

        String nome = scanner.nextLine().trim();

        if (nome.isBlank()) {
            nome = "Frango Congelado";
        }

        Frango frango = new Frango(nome);

        List<Inimigo> inimigos = criarInimigos();

        Combate combate = new Combate(scanner);

        System.out.println(
            "\nSua missão é derrotar todos os inimigos!"
        );

        while (
            frango.estaVivo() &&
            !inimigos.isEmpty()
        ) {

            Inimigo inimigoAtual = inimigos.get(0);

            boolean venceu = combate.iniciarCombate(
                frango,
                inimigoAtual
            );

            if (!venceu) {
                break;
            }

            inimigos.remove(inimigoAtual);

            System.out.println(
                "\nInimigos restantes: " + inimigos.size()
            );
        }

        if (
            frango.estaVivo() &&
            inimigos.isEmpty()
        ) {

            System.out.println(
                "\nO FRANGO VENCEU!"
            );

            System.out.println(
                "O supermercado está livre!"
            );

        } else {

            System.out.println(
                "\nFIM DE JOGO!"
            );
        }

        System.out.println(
            "\nObrigado por jogar O Frango Contra-Ataca!"
        );
    }

    private List<Inimigo> criarInimigos() {

        List<Inimigo> inimigos = new ArrayList<>();

        inimigos.add(new CenouraMutante());
        inimigos.add(new CarrinhoMaluco());
        inimigos.add(new Gerente());

        return inimigos;
    }
}








package mercado;

import mercado.jogo.Jogo;

public class Main {

    public static void main(String[] args) {

        Jogo jogo = new Jogo();

        jogo.iniciar();
    }
}
